  "aug_config": {
    "HorizontalFlip": {
      "p": 0.5
    },
    "Blur": {
      "blur_limit": [
        3,
        9
      ],
      "p": 0.15
    },
    "MotionBlur": {
      "blur_limit": [
        3,
        15
      ],
      "p": 0.15
    },
    "GaussNoise": {
      "std_range": [
        0.04,
        0.15
      ],
      "p": 0.3
    },
    "ISONoise": {
      "color_shift": [
        0.01,
        0.05
      ],
      "intensity": [
        0.1,
        0.5
      ],
      "p": 0.2
    },
    "ImageCompression": {
      "quality_range": [
        30,
        85
      ],
      "p": 0.35
    },
    "RandomBrightnessContrast": {
      "brightness_limit": 0.3,
      "contrast_limit": 0.3,
      "p": 0.4
    },
    "RandomGamma": {
      "gamma_limit": [
        70,
        130
      ],
      "p": 0.2
    },
    "CLAHE": {
      "p": 0.05
    }
