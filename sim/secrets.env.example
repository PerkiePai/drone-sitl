# Copy to sim/secrets.env and fill in. That path is gitignored; this one is not.
#
#   cp sim/secrets.env.example sim/secrets.env
#   chmod 600 sim/secrets.env
#   $EDITOR sim/secrets.env
#
# sim/launch-sitl.sh sources sim/secrets.env when it exists. An already-exported
# CESIUM_ION_TOKEN wins, so a shell profile or a one-off
# `CESIUM_ION_TOKEN=... ./sim/launch-sitl.sh` still overrides the file.

# Cesium ion access token — needed to stream 3D tiles.
# Get one at https://ion.cesium.com/tokens
# It must grant access to every ion asset id in sim/sites.py (asset 2275207,
# Google Photorealistic 3D Tiles, for bangkok-survey-040). A token that is valid
# but not scoped to the asset yields a lit, empty world rather than an error.
export CESIUM_ION_TOKEN=''
