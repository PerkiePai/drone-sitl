{
  "model": "RFDETRMedium(num_classes=1, resolution=640)",
  "train_kwargs": {
    "dataset_dir": "/home/innovation/Tiger/DroneDetectionProject/datasets_rfdetr_group",
    "output_dir": "/home/innovation/Tiger/DroneDetectionProject/runs_rfdetr/truck_group_quality_aug",
    "class_names": [
      "Truck"
    ],
    "epochs": 150,
    "batch_size": 8,
    "grad_accum_steps": 2,
    "num_workers": 8,
    "early_stopping": true,
