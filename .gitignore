__pycache__/
*.py[cod]
.pytest_cache/

# Secrets sourced by sim/launch-sitl.sh. Never commit — see sim/secrets.env.example
sim/secrets.env

# NvStreamer ETW traces. Isaac's WebRTC streamer drops these in the CWD and they
# run to tens of megabytes each.
NvStreamer-*.etli

# Runtime output: Isaac/joystick-server console logs and uploaded agent scripts
# (AGENT_UPLOAD_DIR in joystick-server.py).
logs/

# Private Cesium tile cache (sim/launch-sitl.sh --/app/tokens/omni_global_cache).
# Keeps our runs off the shared, contention-prone ~/.cache/ov; grows large.
.cache/
